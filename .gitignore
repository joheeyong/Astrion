.gradle/
build/
*.class
*.jar
*.war
# Negation must come AFTER *.jar — gitignore rules are last-match-wins,
# so the original ordering (negation first) silently re-ignored the
# wrapper jar and it never reached the repo. Every gradle step in CI was
# failing with 'Unable to access jarfile gradle-wrapper.jar' because of
# this line order.
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Environment
.env
*.log

# Unity
unity-client/Library/
unity-client/Temp/
unity-client/Obj/
unity-client/Logs/
unity-client/UserSettings/
unity-client/MemoryCaptures/
unity-client/Recordings/
unity-client/Builds/
unity-client/*.csproj
unity-client/*.sln
unity-client/*.unitypackage
