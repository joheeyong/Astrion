[Unit]
Description=Astrion Game Server
# Don't try to start before networking is fully up — the Netty bind on 9000
# would fail otherwise during EC2 boot. redis-server is a hard prerequisite;
# the server's RedisManager throws on startup if Redis isn't reachable.
After=network-online.target redis-server.service
Wants=network-online.target
Requires=redis-server.service

# Crash loop guard belongs in [Unit] — systemd ignores these keys silently
# when placed under [Service]. 5 failures inside 60s -> 'failed' state.
# Recovery: sudo systemctl reset-failed astrion-game-server && sudo systemctl start astrion-game-server
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/game-server-0.1.0
ExecStart=/home/ubuntu/game-server-0.1.0/bin/game-server

# Crash recovery: come back up automatically. RestartSec=5 leaves the port
# free long enough for TIME_WAIT to clear if the previous JVM had open
# client sockets.
Restart=always
RestartSec=5

# Give the shutdown hook a real budget. Default would already let it run,
# but pinning the value documents what 'graceful' means here. systemd sends
# SIGTERM, JVM runs the shutdown hook (close listening socket, disconnect
# every player so channelInactive fires, drain Netty, shutdown Redis), then
# the process exits cleanly. SIGKILL only fires if all of that takes >30s,
# which it shouldn't unless the worker group is genuinely stuck.
TimeoutStopSec=30
KillSignal=SIGTERM

# JVM heap. Current load sits well under 100MB used; 512MB max leaves
# generous headroom for /metrics heap_used_mb to grow before we revisit.
#
# Crash dumps:
#   -XX:ErrorFile  — hotspot fatal-error log (segfault, internal JVM bug).
#   -XX:HeapDumpOnOutOfMemoryError + HeapDumpPath — drop a .hprof on OOM
#                                                   so we can post-mortem
#                                                   what blew up the heap.
# Both files land in ~/logs so they sit next to the logback rolling files.
## %% escapes the percent so systemd hands JVM a literal '%p', which the
## JVM then substitutes with the process PID. Without escaping, systemd
## expands %p to the unit name and every crash overwrites the same file.
##
## +ExitOnOutOfMemoryError: load-test runs showed OOM left the JVM in a
## half-dead state where the listener stopped accepting but the process
## was still alive, so systemd never tried to restart. The flag makes the
## JVM exit immediately on OOM, which trips Restart=always above and
## brings the server back in 5s. HeapDumpOnOutOfMemoryError still fires
## before exit so the .hprof is captured for post-mortem.
Environment="JAVA_OPTS=-Xms256m -Xmx512m -XX:ErrorFile=/home/ubuntu/logs/jvm-crash-%%p.log -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/home/ubuntu/logs -XX:+ExitOnOutOfMemoryError"

# TLS material. Paths match the defaults inside GameServerMain, but we
# pin them here so the unit file alone tells you where the cert lives.
Environment="ASTRION_TLS_CERT=/home/ubuntu/game-server-cert/server.crt"
Environment="ASTRION_TLS_KEY=/home/ubuntu/game-server-cert/server.key"

# Redis AUTH credential, read from a file outside the unit so the password
# isn't visible in systemctl show / journal output. The file is chmod 600
# and owned by ubuntu; the unit runs as ubuntu so it can read.
# Format: ASTRION_REDIS_PASSWORD=...
EnvironmentFile=-/home/ubuntu/.config/astrion/redis-password.env

# Routing: rolling INFO log goes to ~/logs/server.log via logback, so the
# journal only needs to catch what falls outside that — startup banner,
# JVM-level crashes, anything written to stdout before logback initialises.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=astrion

[Install]
WantedBy=multi-user.target
